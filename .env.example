LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=

# Dedicated shared token configured in the backend.
AGENT_API_TOKEN=
FASTAPI_BASE_URL=http://127.0.0.1:8000

AGENT_NUM_IDLE_PROCESSES=1
AGENT_LOAD_THRESHOLD=0.95
AGENT_HTTP_PORT=8081
OUTGOING_AGENT_HTTP_PORT=8082
OUTGOING_AGENT_NAME=outgoing-agent

# Use this shared path when workers run from versioned release directories.
CALL_DIAGNOSTICS_DIR=/home/rei/apps/livekit-agent/runtime/calls
